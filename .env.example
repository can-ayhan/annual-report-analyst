# Copy to .env. The database values match docker-compose.yml and can stay as they are.
PGHOST=localhost
PGPORT=5436
PGDATABASE=reports
PGUSER=analyst
PGPASSWORD=analyst

# Needed for `analyst ask` and `analyst eval`; indexing, searching and the MCP server run without it.
# A key from the free tier at console.groq.com is enough.
GROQ_API_KEY=

# The Groq chat model the agents use. Required, there is no default.
# evals/models.yml lists the ones that were compared.
ANALYST_MODEL=

# Optional: another embedding model supported by fastembed. It has to produce 384 dimensions.
# EMBEDDING_MODEL=
